# Get a token from @BotFather in Telegram.
TELEGRAM_BOT_TOKEN=put_your_token_here

# Optional: Postgres connection string for production state persistence.
# If unset, the bot falls back to a local JSON file (./data/games.json).
# Example: postgresql://user:pass@ep-xxx.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Optional: comma-separated whitelist of Telegram chat IDs where the bot is
# allowed to actually run matches / write messages. If unset, the bot operates
# in any group chat that adds it.
# Example: OPERATE_CHAT_IDS=-1002902752126
OPERATE_CHAT_IDS=

# Optional: comma-separated whitelist of chats whose members can DM the bot.
# Operate chats are implicitly included. If unset, anyone can DM.
# Example: ALLOWED_CHAT_IDS=-1002902752126,-1001980467135
ALLOWED_CHAT_IDS=
